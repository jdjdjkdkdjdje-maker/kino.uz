# Docker/PostgreSQL
POSTGRES_DB=kinotv
POSTGRES_USER=kinotv
POSTGRES_PASSWORD=kinotv_dev_password
DATABASE_URL=postgresql://kinotv:kinotv_dev_password@localhost:5432/kinotv?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
PORT=4000
ADMIN_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api/v1
# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kinotv
S3_ACCESS_KEY=kinotv_minio
S3_SECRET_KEY=kinotv_minio_password
S3_PUBLIC_URL=http://localhost:9000/kinotv
# Admin web browser API URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
