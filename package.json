{
  "name": "kinotv-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "admin"
  ],
  "scripts": {
    "install:all": "npm install && cd mobile && flutter pub get",
    "dev:backend": "npm --workspace backend run start:dev",
    "dev:admin": "npm --workspace admin run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace backend",
    "lint": "npm run lint --workspaces"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lodash": "4.18.1",
    "@nestjs/swagger@11.4.6": {
      "js-yaml": "5.2.3"
    }
  }
}
